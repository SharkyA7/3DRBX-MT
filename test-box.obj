# Simple box UV test model
# Vertices
v -0.5 -0.5 -0.5
v 0.5 -0.5 -0.5
v 0.5 0.5 -0.5
v -0.5 0.5 -0.5
v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5

# UV coordinates (all faces mapped to full 0-1 space for easy debugging)
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Normals
vn 0 0 -1
vn 0 0 1
vn -1 0 0
vn 1 0 0
vn 0 -1 0
vn 0 1 0

# Faces with UVs (6 faces, 2 triangles each = 12 triangles)
# Front face (-Z)
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# Back face (+Z)
f 5/1/2 8/2/2 7/3/2
f 5/1/2 7/3/2 6/4/2
# Left face (-X)
f 5/1/3 1/2/3 4/3/3
f 5/1/3 4/3/3 8/4/3
# Right face (+X)
f 2/1/4 6/2/4 7/3/4
f 2/1/4 7/3/4 3/4/4
# Bottom face (-Y)
f 5/1/5 6/2/5 2/3/5
f 5/1/5 2/3/5 1/4/5
# Top face (+Y)
f 4/1/6 3/2/6 7/3/6
f 4/1/6 7/3/6 8/4/6