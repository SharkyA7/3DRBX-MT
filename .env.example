# Roblox API (required)
ROBLOX_COOKIE=your_roblox_cookie_here

# Roblox OAuth (required for user auth)
ROBLOX_OAUTH_CLIENT_ID=your_oauth_client_id
ROBLOX_OAUTH_CLIENT_SECRET=your_oauth_client_secret
ROBLOX_OAUTH_REDIRECT_URI=https://your-domain.com/auth/roblox/callback

# Supabase (required for API keys, custom catalogs, maintenance mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key  # Must bypass RLS for admin operations

# Session secret (required for production)
SESSION_SECRET=your_session_secret_32_chars_min

# Maintenance mode (optional)
MAINTENANCE_ADMIN_PASSWORD=your_admin_password

# Rust model parser (optional - for SurfaceAppearance/PBR support)
ROBLOX_MODEL_PARSER_URL=http://localhost:8080/parse